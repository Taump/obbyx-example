# Obyte network: obyte:testnet or obyte:livenet (livenet also needs ALLOW_LIVENET=1).
# docker-compose passes it to the facilitator and the watcher too.
NETWORK=obyte:testnet

# Seller: payout address and a secret (>= 32 chars) that binds payments to requests.
#   echo "PAY_TO=$(OBBYX_HOME=~/.obbyx-seller npx obbyx address)" >> .env
#   echo "SELLER_SECRET=$(openssl rand -hex 32)" >> .env
# PAY_TO=
# SELLER_SECRET=

# Seller wallet directory, mounted into the watcher container.
OBBYX_SELLER_HOME=~/.obbyx-seller

FACILITATOR_URL=http://127.0.0.1:4021
SELLER_URL=http://127.0.0.1:3402
PORT=3402

# Smallest channel dispute window (seconds) the seller and facilitator accept.
MIN_CHANNEL_TIMEOUT=3600
